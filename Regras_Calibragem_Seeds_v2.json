      ],
      "special": "ídolo ainda joga; conflito entre minutos simbólicos e desempenho"
    },
    "Base de Ouro": {
      "roster_style": "prospect_core",
      "avg_age": [
        21.5,
        25
      ],
      "avg_development_gap": [

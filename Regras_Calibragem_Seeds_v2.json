      }
    }
  },
  "lore_overrides": {
    "Lenda no Banco": {
      "roster_style": "veteran_win_now",
      "avg_age": [
        28.5,
        32.5
      ],
      "special": "treinador ídolo, proteção inicial da torcida, pressão após sequência ruim"
    },
    "Estátua Viva": {
      "roster_style": "veteran_win_now",
      "avg_age": [
        29,

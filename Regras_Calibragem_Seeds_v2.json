      ],
      "variance": "alta"
    },
    "Elenco Remendado": {
      "roster_style": "medical_risk",
      "avg_age": [
        27,
        32
      ],
      "injury_risk": "alto"
    },
    "Diretoria Impaciente": {
      "salary_pressure_pct": [
        90,
        130
      ],
      "pressure": "alta/muito alta"
    },
    "Máquina de Marketing": {
      "budget": [
        85,
        150
      ],
      "media_exposure": "alta",
      "salary_pressure_pct": [
        85,
        125
      ]
    },
    "Gigante Adormecido": {
      "reputation": "alta",
      "pressure": "muito alta",
      "budget": [
        75,
        140
      ]
    }
  },
  "reroll_rules": [
    {
      "if": "strength_tier == low && overall_rating > 74 && !cinderella_seed",
      "then": "reroll roster current downward"
    },
    {
      "if": "roster_style == veteran_win_now && avg_age < 28",
      "then": "ageUpCore() + reducePotentialGap()"
    },
    {
      "if": "roster_style == prospect_core && avg_age > 25.5",
      "then": "replaceVeteransWithProspects()"
    },
    {
      "if": "ambition == sobrevivencia && overall_rating > 74",
      "then": "downgrade overall or set cinderella_seed flag"
    },
    {
      "if": "lore_label in [Lenda no Banco, Estatua Viva, Reino dos Veteranos] && avg_age < 28.5",
      "then": "forceVeteranLoreProfile()"
    },
    {
      "if": "salary_pressure_pct > 135 && lore not in financial_crisis/high_risk",
      "then": "reducePayroll or convert to crisis lore"
    },
    {
      "if": "budget_left < 0",
      "then": "add financial warning and reduce market aggressiveness"
    }
  ]
}